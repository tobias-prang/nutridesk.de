# Server
NODE_ENV=production
PORT=8420
BIND_ADDR=127.0.0.1

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nutridesk
DB_PASS=HIER_SICHERES_DATENBANKPASSWORT_EINTRAGEN
DB_NAME=nutridesk

# Sicherheit / Anmeldung
JWT_SECRET=HIER_MINDESTENS_64_ZUFAELLIGE_ZEICHEN_EINTRAGEN
REGISTRATION_OPEN=1
# Optional: Registrierung nur mit Einladungscode erlauben
REGISTRATION_CODE=

# FinTS: registrierte Produkt-ID eintragen. Alternativ FINTS_PRODUCT_FILE verwenden.
FINTS_PRODUCT_ID=
FINTS_PRODUCT_FILE=/home/.produkt-register-fints

# Dateiablage und Virenscanner
CLOUD_ROOT=/home/nutridesk.de/cloud
QUARANTINE_ROOT=/home/nutridesk.de/quarantine
STORAGE_ROOT=/home/nutridesk.de/storage
CLAMD_SOCKET=/var/run/clamav/clamd.ctl

# E-Mail-Versand fuer neue Konten und sichere Passwort-Zuruecksetzung
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NutriDesk <noreply@nutridesk.de>"
# Erst aktivieren, wenn ein externer Testempfänger die Nachricht erhalten hat.
SMTP_DELIVERY_ENABLED=0

# Changelog aus GitHub Releases. Bei privaten Repositories ist ein nur lesbares
# Fine-grained Token mit Zugriff auf "Contents: read" erforderlich.
GITHUB_REPOSITORY=tobias-prang/nutridesk.de
GITHUB_TOKEN=

# Sprachdienst bleibt standardmaessig lokal/aus. Nur bewusst aktivieren.
CLOUD_TTS_AVAILABLE=0
ELEVENLABS_FILE=/home/.elevenlabs.json

# Optionaler lokaler Wissensdienst
WIKI_URL=http://127.0.0.1:35248
