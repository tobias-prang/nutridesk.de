{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NutriDesk",
  "version": "1.0.1",
  "identifier": "de.nutridesk.app",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NutriDesk",
        "width": 1500,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBREM5ODlGMDQyNzI5RTIKUldUaUtTY0VuNWpjS2xFRlQ3MGt4UjNUYVEzRThiN0tOVFNsNUl4T2N1bkd0bzl5VGRhc3V4RzEK",
      "endpoints": [
        "https://nutridesk.de/updates/tauri.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
